# Server-side only. Never expose this value through a NEXT_PUBLIC_* variable.
OPENAI_API_KEY=

# Cost-efficient model for a focused, structured explanation task.
OPENAI_MODEL=gpt-6-luna
QUANTAI_YFINANCE_CACHE_DIR=
QUANTAI_MARKET_DATA_CACHE_DIR=
QUANTAI_FUNDAMENTAL_CACHE_DIR=

# Comma-delimited exact frontend origins, without paths. Required for public hosting.
# Example: https://quantai.example.com,https://quantai.vercel.app
QUANTAI_CORS_ORIGINS=
